
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check for admin role by looking for a document in the roles_admin collection.
      // This is more secure and reliable for rules than custom claims.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      // Users can read/write their own data.
      // Admins can read/write any user's data.
      allow read, write: if request.auth.uid == userId || isAdmin();

      match /cart/{cartItemId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /orders/{orderId} {
         allow read, create: if request.auth.uid == userId;
         // Allow user to update their own order only to cancel or complete.
         allow update: if request.auth.uid == userId
                      && request.resource.data.status != resource.data.status
                      && (request.resource.data.status == 'completed' || request.resource.data.status == 'cancelled');
         // Admins can manage all orders.
         allow get, list, update: if isAdmin();
      }
    }
    
    // Admins have full access to manage roles.
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }

    match /dashboard_metrics/{metricId} {
      allow read, write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    match /inventory/{itemId} {
      // Any authenticated user can read inventory.
      allow get, list: if request.auth != null;
      // Only admins can write to inventory.
      allow write: if isAdmin();
      
      match /variants/{variantId} {
        // Only admins can manage variants.
        allow read, write: if isAdmin();
      }
    }

    // Admins can query the 'orders' collection group for notifications.
    match /{path=**}/orders/{orderId} {
      allow list: if isAdmin();
    }
  }
}
