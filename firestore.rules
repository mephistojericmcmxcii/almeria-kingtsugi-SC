/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with ownership for user data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Accessible only to the user themselves.
 * - /roles_admin/{userId}: Indicates admin status. The existence of a document grants admin privileges.
 * - /dashboard_metrics/{metricId}: Stores dashboard metrics. Accessible only to admins.
 * - /system_settings/{settingId}: Stores system settings. Accessible only to admins.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Admin privileges are determined by the presence of a document in the /roles_admin collection.
 * - Listing of users or admin roles is disallowed.
 *
 * Denormalization for Authorization:
 * - Admin status is determined by the existence of a document in `/roles_admin/{userId}`. This avoids the need to read user profile data during authorization.
 *
 * Structural Segregation:
 * - System settings, which require admin-only access, are stored in `/system_settings`, segregated from user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @allow (get) User with ID 'user123' can retrieve their profile.
     * @deny (get) User with ID 'user456' cannot retrieve the profile of 'user123'.
     * @allow (update) User with ID 'user123' can update their profile.
     * @deny (update) User with ID 'user456' cannot update the profile of 'user123'.
     * @allow (delete) User with ID 'user123' can delete their profile.
     * @deny (delete) User with ID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for writes.  Users can only read and write their own profile data.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the existing document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages admin role assignments. The existence of a document grants admin privileges.
     * @path /roles_admin/{userId}
     * @allow (create) An admin role can be created for a user.
     * @deny (create) A non-admin cannot create an admin role.
     * @allow (get) Admins can read the documents in /roles_admin
     * @deny (get) Non-admins cannot read the documents in /roles_admin.
     * @allow (update) An admin role can be updated for a user.
     * @deny (update) A non-admin cannot update an admin role.
     * @allow (delete) An admin role can be deleted for a user.
     * @deny (delete) A non-admin cannot delete an admin role.
     * @principle Authorization Independence: Admin privileges are determined by the existence of a document in /roles_admin/{userId}.
     */
    match /roles_admin/{userId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get: if isAdmin();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

    /**
     * @description Controls access to dashboard metrics. Only admins can read and write these metrics.
     * @path /dashboard_metrics/{metricId}
     * @allow (create) Admins can create new dashboard metrics.
     * @deny (create) Non-admins cannot create dashboard metrics.
     * @allow (get) Admins can retrieve dashboard metrics.
     * @deny (get) Non-admins cannot retrieve dashboard metrics.
     * @allow (update) Admins can update dashboard metrics.
     * @deny (update) Non-admins cannot update dashboard metrics.
     * @allow (delete) Admins can delete dashboard metrics.
     * @deny (delete) Non-admins cannot delete dashboard metrics.
     * @principle Role-based access control: Only users with the 'Admin' role can access dashboard metrics.
     */
    match /dashboard_metrics/{metricId} {
      function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to system settings. Only admins can read and write these settings.
     * @path /system_settings/{settingId}
     * @allow (create) Admins can create new system settings.
     * @deny (create) Non-admins cannot create system settings.
     * @allow (get) Admins can retrieve system settings.
     * @deny (get) Non-admins cannot retrieve system settings.
     * @allow (update) Admins can update system settings.
     * @deny (update) Non-admins cannot update system settings.
     * @allow (delete) Admins can delete system settings.
     * @deny (delete) Non-admins cannot delete system settings.
     * @principle Role-based access control: Only users with the 'Admin' role can access system settings.
     */
    match /system_settings/{settingId} {
      function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}