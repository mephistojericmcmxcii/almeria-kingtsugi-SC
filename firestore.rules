
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Collection group access for variants (important)
    match /{path=**}/variants/{variantId} {
      allow read: if true;
    }

    // ---------- INVENTORY ----------
    match /inventory/{itemId} {

      allow read: if true;

      allow create, delete: if request.auth != null &&
                            request.auth.token.admin == true;

      allow update: if request.auth != null &&
                    request.auth.token.admin == true;

      match /variants/{variantId} {
        allow read: if true;

        allow create, delete: if request.auth != null &&
                              request.auth.token.admin == true;

        // Allow admin to update anything, but guests can only update quantity (e.g. for a sale)
        // This is a more complex rule that might be useful later.
        allow update: if request.auth != null &&
                      (request.auth.token.admin == true ||
                       request.resource.data.diff(resource.data)
                               .changedKeys().hasOnly(["quantity"]));
      }
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read, write: if request.auth != null &&
                   request.auth.uid == userId;

      match /cart/{cartId} {
        allow read, write: if request.auth != null &&
                           request.auth.uid == userId;
      }

      match /orders/{orderId} {
        // User can R/W own orders, admin can R/W any
        allow read, write: if (request.auth != null && request.auth.uid == userId) || (request.auth != null && request.auth.token.admin == true);
      }

      match /rfq/{rfqId} {
        // User can R/W own RFQs, admin can read any
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if (request.auth != null && request.auth.uid == userId) || (request.auth != null && request.auth.token.admin == true);
      }
    }

    // --- Admin-only collections
    match /roles_admin/{userId} {
        allow read: if request.auth != null && request.auth.token.admin == true;
    }

    match /purchase_orders/{poId} {
      allow read, write: if request.auth != null &&
                         request.auth.token.admin == true;
       match /items/{itemId} {
         allow read, write: if request.auth != null &&
                         request.auth.token.admin == true;
       }
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.token.admin == true;
    }

    // ---------- FALLBACK ----------
    // This is a safer fallback. It denies all writes unless you are an admin,
    // and reads are implicitly denied unless explicitly allowed in the rules above.
    match /{document=**} {
      allow write: if request.auth != null &&
                   request.auth.token.admin == true;
      allow read: if false; // Deny all other reads by default
    }
  }
}
