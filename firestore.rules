
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper function: check admin ---
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // --- Users collection ---
    match /users/{userId} {
      // A newly created user can create their own document.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // An existing user can only read, update, or delete their own document.
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Admin can read/write all users
      allow read, write: if isAdmin();

      // --- Cart subcollection ---
      match /cart/{cartItemId} {
        // A user can read/write their own cart items
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // --- Orders subcollection ---
      match /orders/{orderId} {
        // User can R/W their own orders subcollection. Admin can R/W any.
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }
    
    // --- Inventory collection ---
    match /inventory/{itemId} {

      // Any authenticated user can write to inventory
      allow write: if request.auth != null;

      // All users: read only for parent item
      allow read: if request.auth != null;

      // --- Variants subcollection ---
      match /variants/{variantId} {
        // Allow reads for authenticated users (for dashboard)
        allow read: if request.auth != null;
        
        // Allow full writes for any authenticated user
        allow write: if request.auth != null;
      }
    }
    
    // --- Admin Roles collection ---
    match /roles_admin/{userId} {
      // Admins can read this to check other admins, but never write.
      // Writes should only happen from a secure backend.
      allow read: if isAdmin();
    }
    
    // --- RFQ Records collection ---
    match /rfq-records/{rfqId} {
      // Any authenticated user can create a request.
      allow create: if request.auth != null;
      // Only admins can read, update, or delete requests.
      allow read, update, delete: if isAdmin();
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
