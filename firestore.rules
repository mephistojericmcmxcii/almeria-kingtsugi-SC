
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper function: check admin ---
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // --- Users collection ---
    match /users/{userId} {

      // A user can read/write ONLY their own doc
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Admin can read/write all users
      allow read, write: if isAdmin();

      // --- Cart subcollection ---
      match /cart/{cartItemId} {
        // A user can read/write their own cart items
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // --- Orders subcollection ---
      match /orders/{orderId} {
        // A user can read their own orders
        allow read: if request.auth != null && request.auth.uid == userId;

        // An admin can read and update any order
        allow read, write: if isAdmin();
      }
    }

    // --- Inventory collection ---
    match /inventory/{itemId} {

      // Admin full access
      allow read, write: if isAdmin();

      // Normal users: read only
      allow read: if request.auth != null;

      // --- Variants subcollection ---
      match /variants/{variantId} {
        // Allow reads for authenticated users (for dashboard)
        allow read: if request.auth != null;
        // Allow writes only for admins
        allow write: if isAdmin();
      }
    }
    
    // --- Admin Roles collection ---
    match /roles_admin/{userId} {
      // Admins can read this to check other admins, but never write.
      // Writes should only happen from a secure backend.
      allow read: if isAdmin();
    }
    
    // --- All other orders (for collectionGroup query) ---
    match /{path=**}/orders/{orderId} {
      // Admins can read all orders from any user path
      allow read: if isAdmin();
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
