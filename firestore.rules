
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper function: check admin ---
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // --- Users collection ---
    match /users/{userId} {
      // A newly created user can create their own document.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // An existing user can only read, update, or delete their own document.
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Admin can read/write all users
      allow read, write: if isAdmin();

      // --- Cart subcollection ---
      match /cart/{cartItemId} {
        // A user can read/write their own cart items
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // --- Orders subcollection ---
      match /orders/{orderId} {
        // User can R/W their own orders subcollection. Admin can R/W any.
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }
    
    // --- Inventory collection ---
    match /inventory/{itemId} {

      // Admin full access
      allow write: if isAdmin();

      // All users: read only for parent item
      allow read: if request.auth != null;

      // --- Variants subcollection ---
      match /variants/{variantId} {
        // Allow reads for authenticated users (for dashboard)
        allow read: if request.auth != null;
        
        // Allow full writes only for admins
        allow create, delete: if isAdmin();
        
        // Allow updates for admins.
        // Allow updates for any authenticated user ONLY IF they are decrementing quantity
        // and not changing any other field. This is for order placement.
        allow update: if isAdmin() || 
                      (request.auth != null && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']) &&
                       request.resource.data.quantity == resource.data.quantity - request.resource.data.diff(resource.data).unchangedKeys().quantity);
      }
    }
    
    // --- Admin Roles collection ---
    match /roles_admin/{userId} {
      // Admins can read this to check other admins, but never write.
      // Writes should only happen from a secure backend.
      allow read: if isAdmin();
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
